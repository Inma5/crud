# =====================================================================
# VARIABLES DE ENTORNO - API EXPERIENCIAS PROFESIONALES (CV)
# =====================================================================

# Puerto del servidor (en desarrollo local; en Vercel lo asigna la plataforma)
PORT=3000

# Entorno de ejecución: development | production | test
NODE_ENV=development

# ---------------------------------------------------------------------
# BASE DE DATOS MONGODB
# ---------------------------------------------------------------------
# Para desarrollo local con MongoDB local:
# MONGODB_URI=mongodb://localhost:27017/cv_experiencias

# Para despliegue en VERCEL o Producción (OBLIGATORIO configurar en Vercel Dashboard):
# Obtén tu URI gratuita en MongoDB Atlas (https://www.mongodb.com/cloud/atlas):
MONGODB_URI=mongodb+srv://<usuario>:<password>@<cluster>.mongodb.net/cv_experiencias?retryWrites=true&w=majority

# Fallback automático a base de datos en memoria (MongoMemoryServer)
# NOTA: Solo funciona en desarrollo local para pruebas rápidas si no tienes MongoDB instalado.
# En Vercel / Producción este fallback se desactiva automáticamente por seguridad.
AUTO_FALLBACK_MEMORY_DB=true
